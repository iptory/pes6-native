{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-amd64-release-local",
      "inherits": "win-amd64-release",
      "displayName": "Windows x64 Release with a local ReXGlue install",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/path/to/rexglue-sdk/out/install/win-amd64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-release-local",
      "configurePreset": "win-amd64-release-local"
    }
  ]
}
